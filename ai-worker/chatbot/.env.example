# =====================================================
# Modelo do arquivo .env  -  DECODE
# =====================================================
#
# COMO USAR
# ---------
# 1. Na EC2, dentro da pasta ~/decode-chatbot, crie o arquivo .env
#    (o nome começa com ponto e NÃO tem extensão).
# 2. Copie as linhas abaixo para dentro dele.
# 3. Troque os textos de exemplo pelos valores REAIS.
# 4. NÃO coloque aspas, NÃO deixe espaços ao redor do "=".
# 5. NUNCA envie este arquivo para o GitHub nem para outras
#    pessoas: ele guarda senhas (chaves de acesso).

# Chave da Groq (a mesma usada nas aulas)
GROQ_API_KEY=cole_aqui_a_chave_da_groq

# Token do bot, entregue pelo BotFather no Telegram.
# UM token = UM bot ligado (senão dá erro 409).
#   - testes:   token do decode_staging_bot
#   - produção: token do decode_bot
TELEGRAM_TOKEN=cole_aqui_o_token_do_botfather

# Endereço da API que o bot vai chamar.
# Como o bot roda na MESMA máquina da API (a EC2),
# use localhost. Não precisa trocar.
API_URL=http://localhost:8000

# (OPCIONAL) Restringe o bot a alguns chats do Telegram, por exemplo
# durante a apresentação. Coloque os chat_id separados por vírgula,
# sem espaços e sem aspas. Se esta linha não existir, o bot responde
# a todos. Para descobrir um chat_id: peça à pessoa para enviar
# mensagem ao bot e veja o log ("Chat não permitido: NÚMERO").
# ALLOWED_CHAT_IDS=123456789,987654321
