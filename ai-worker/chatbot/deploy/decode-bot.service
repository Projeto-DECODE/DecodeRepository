# =====================================================
# decode-bot.service  -  mantém o bot sempre ligado
# =====================================================
#
# Instalar em: /etc/systemd/system/decode-bot.service
# Este arquivo é a CÓPIA FIEL do que roda na EC2 do DECODE
# (instalação em /opt/decode-chatbot, usuário decode-chatbot).
# Passo a passo completo: docs/implantacao.md, seção 9.

[Unit]
Description=DECODE Bot do Telegram
# Inicia depois da rede e depois da API
After=network.target decode-api.service
# Se a API não puder iniciar, o bot também não inicia
Wants=decode-api.service

[Service]
# Usuário de sistema, sem login e sem senha
User=decode-chatbot
WorkingDirectory=/opt/decode-chatbot/repo/ai-worker/chatbot
# Mesmo comando que você roda à mão (python da .venv)
ExecStart=/opt/decode-chatbot/.venv/bin/python bot.py
Environment=HOME=/opt/decode-chatbot
# Mostra os prints do bot na hora no journalctl
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
# O bot é leve: limite de memória baixo
MemoryMax=400M
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
