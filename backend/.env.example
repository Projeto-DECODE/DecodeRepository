# Copie para backend/.env (que NÃO é versionado) e preencha localmente.
# Todos os valores abaixo são fictícios. Gere segredos fortes com:
#   openssl rand -base64 36

# Superusuário do PostgreSQL (usado só na inicialização do banco)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

# Senha da role de cada serviço (uma por schema)
AUTH_DB_PASSWORD=change-me
BUCKET_DB_PASSWORD=change-me
OBJECT_DB_PASSWORD=change-me

# Segredo do client credentials entre serviços (mínimo de 32 caracteres)
BUCKET_SERVICE_CLIENT_SECRET=change-me-with-at-least-32-characters

# Opcionais (os valores abaixo são os padrões)
# JWT_USER_TTL=15m
# JWT_SERVICE_TTL=5m
# MAX_FILE_SIZE=50MB
# MAX_REQUEST_SIZE=51MB
