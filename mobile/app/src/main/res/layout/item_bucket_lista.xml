<?xml version="1.0" encoding="utf-8"?>
<!-- Modo lista: faixa horizontal -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/CartaoVidro"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="4dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/fundoIcone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgTipo"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_folder" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtNomeBucket"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/txtDataBucket"
            app:layout_constraintEnd_toStartOf="@id/btnExcluir"
            app:layout_constraintStart_toEndOf="@id/fundoIcone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="relatorios-mensais" />

        <TextView
            android:id="@+id/txtDataBucket"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/numeros"
            app:layout_constraintEnd_toEndOf="@id/txtNomeBucket"
            app:layout_constraintStart_toStartOf="@id/txtNomeBucket"
            app:layout_constraintTop_toBottomOf="@id/txtNomeBucket"
            tools:text="Criado em 02/11/2026" />

        <LinearLayout
            android:id="@+id/numeros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/txtNomeBucket"
            app:layout_constraintTop_toBottomOf="@id/txtDataBucket">

            <TextView
                android:id="@+id/txtImagens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_imagens"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_mini_image"
                app:drawableTint="@color/texto_secundario"
                tools:text="25" />

            <TextView
                android:id="@+id/txtDocs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/cd_docs"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_mini_document"
                app:drawableTint="@color/texto_secundario"
                tools:text="3" />

            <TextView
                android:id="@+id/txtOutros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/cd_outros"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_mini_file"
                app:drawableTint="@color/texto_secundario"
                tools:text="0" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnExcluir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="@dimen/toque_minimo"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/botao_excluir"
            android:textColor="@color/erro"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
