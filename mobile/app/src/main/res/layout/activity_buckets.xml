<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    tools:context=".BucketsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/fundo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/titulo_buckets" />

    <TextView
        android:id="@+id/txtSaudacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/margem"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/texto"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintWidth_max="688dp"
        tools:text="Olá, Maria" />

    <TextView
        android:id="@+id/txtQuantidade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/txtSaudacao"
        app:layout_constraintStart_toStartOf="@id/txtSaudacao"
        app:layout_constraintTop_toBottomOf="@id/txtSaudacao"
        tools:text="4 buckets" />

    <!-- Largura máxima de 720 dp para não esticar demais no tablet -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBuckets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margem"
        android:paddingEnd="@dimen/margem"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtQuantidade"
        app:layout_constraintWidth_max="@dimen/largura_max_lista"
        tools:listitem="@layout/item_bucket" />

    <ProgressBar
        android:id="@+id/progressCarregando"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <TextView
        android:id="@+id/txtVazio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:text="@string/buckets_vazio"
        android:textColor="@color/texto_secundario"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintWidth_max="@dimen/largura_max_form" />

    <TextView
        android:id="@+id/txtErro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:textColor="@color/texto"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/btnTentar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="@dimen/largura_max_form"
        tools:text="Não foi possível conectar ao servidor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTentar"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/altura_campo"
        android:layout_marginTop="16dp"
        android:text="@string/botao_tentar_novamente"
        app:cornerRadius="@dimen/raio_cartao"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtErro" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/grupoErro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="txtErro,btnTentar" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNovoBucket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margem"
        android:contentDescription="@string/cd_novo_bucket"
        app:backgroundTint="@color/azul_primario"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/branco" />

</androidx.constraintlayout.widget.ConstraintLayout>
