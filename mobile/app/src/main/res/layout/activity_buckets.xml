<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fundo_tela"
    tools:context=".BucketsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarEscura"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:logo="@drawable/ic_logo"
        app:title="@string/app_name"
        app:titleMarginStart="12dp" />

    <!-- Bloco do topo: limitado a 720 dp no tablet -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margem"
        android:paddingEnd="@dimen/margem"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintWidth_max="@dimen/largura_max_lista">

        <TextView
            android:id="@+id/txtSaudacao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/acento"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Olá, Hélio" />

        <TextView
            android:id="@+id/txtTitulo"
            style="@style/TituloTela"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_buckets"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtSaudacao" />

        <TextView
            android:id="@+id/txtQuantidade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTitulo"
            tools:text="6 buckets · 39 arquivos" />

        <!-- Busca -->
        <EditText
            android:id="@+id/edtBusca"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_marginTop="16dp"
            android:autofillHints=""
            android:drawablePadding="10dp"
            android:hint="@string/buscar_bucket"
            android:imeOptions="actionSearch"
            android:inputType="textNoSuggestions"
            android:drawableStart="@drawable/ic_search"
            android:drawableTint="@color/texto_secundario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtQuantidade" />

        <!-- Ordem e modo de exibição -->
        <Spinner
            android:id="@+id/spnOrdem"
            android:layout_width="0dp"
            android:layout_height="@dimen/toque_minimo"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_campo"
            android:contentDescription="@string/cd_ordem"
            android:entries="@array/ordens_bucket"
            android:paddingStart="8dp"
            android:popupBackground="@color/cartao_claro"
            app:layout_constraintEnd_toStartOf="@id/grupoModo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edtBusca" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupoModo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/spnOrdem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/spnOrdem"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModoRotativo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="@dimen/toque_minimo"
                android:contentDescription="@string/modo_rotativo"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:tooltipText="@string/modo_rotativo"
                app:icon="@drawable/ic_carousel"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModoGrade"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="@dimen/toque_minimo"
                android:contentDescription="@string/modo_grade"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:tooltipText="@string/modo_grade"
                app:icon="@drawable/ic_grid"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModoLista"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="@dimen/toque_minimo"
                android:contentDescription="@string/modo_lista"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:tooltipText="@string/modo_lista"
                app:icon="@drawable/ic_list"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Brilho verde atrás do cartão central (só no rotativo) -->
    <View
        android:id="@+id/brilho"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/bg_brilho"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recyclerBuckets"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/recyclerBuckets" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBuckets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toTopOf="@id/rodapeRotativo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topo"
        app:layout_constraintWidth_max="@dimen/largura_max_lista"
        tools:listitem="@layout/item_bucket_grade" />

    <!-- Rodapé do rotativo: bolinhas de posição e "Criar novo bucket" -->
    <LinearLayout
        android:id="@+id/rodapeRotativo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/pontos"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCriarNovo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/altura_campo"
            android:layout_marginTop="12dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/criar_novo_bucket"
            android:textColor="@color/texto"
            app:backgroundTint="@color/cartao"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/acento"
            app:strokeColor="@color/acento" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressCarregando"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/acento"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topo" />

    <TextView
        android:id="@+id/txtVazio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:drawablePadding="16dp"
        android:gravity="center"
        android:text="@string/buckets_vazio"
        android:textColor="@color/texto_secundario"
        android:textSize="16sp"
        android:visibility="gone"
        app:drawableTopCompat="@drawable/ic_folder"
        app:drawableTint="@color/texto_secundario"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topo"
        app:layout_constraintWidth_max="@dimen/largura_max_form" />

    <TextView
        android:id="@+id/txtErro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:textColor="@color/texto"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/btnTentar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topo"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="@dimen/largura_max_form"
        tools:text="Não foi possível conectar ao servidor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTentar"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/altura_campo"
        android:layout_marginTop="16dp"
        android:text="@string/botao_tentar_novamente"
        app:cornerRadius="@dimen/raio_botao"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtErro" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/grupoErro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="txtErro,btnTentar" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNovoBucket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margem"
        android:contentDescription="@string/cd_novo_bucket"
        app:backgroundTint="@color/acento"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/texto_sobre_acento" />

</androidx.constraintlayout.widget.ConstraintLayout>
