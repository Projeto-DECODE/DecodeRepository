<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/margem_tela"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/margem_tela">

    <EditText
        android:id="@+id/edtNomeBucket"
        style="@style/Campo"
        android:layout_width="0dp"
        android:autofillHints=""
        android:digits="abcdefghijklmnopqrstuvwxyz0123456789-"
        android:hint="@string/novo_bucket_campo"
        android:inputType="textNoSuggestions|textVisiblePassword"
        android:maxLength="63"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtDicaBucket"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/novo_bucket_dica"
        android:textColor="@color/texto_secundario"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtNomeBucket" />

</androidx.constraintlayout.widget.ConstraintLayout>
