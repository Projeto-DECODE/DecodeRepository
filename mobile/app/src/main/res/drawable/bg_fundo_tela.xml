<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo das telas: escuro com uma luz verde bem sutil no topo, como no site -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/fundo" />
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0"
                android:gradientRadius="420dp"
                android:startColor="#1439FF14"
                android:endColor="#0039FF14" />
        </shape>
    </item>
</layer-list>
